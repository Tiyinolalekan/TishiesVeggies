@page
@model TishiesVeggies.Pages.LogPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>History</h1>
<div class="text-center">
    <p style="font-style:italic">Eat banana. Receive coin. Business is booming.</p>
</div>
<br />
<hr />

<div class="history-card"> 
<table class="table">
    <tr>
        @foreach (var day in Model.HistoryVM.History)
        {
            <h4 style="color:gray">@day.Date.ToString("dddd d MMMM yyyy")</h4>
            <br />
           <h5>Quantity: @day.Quantity</h5>
            <ul>
                    @foreach (var fruit in day.Fruits)
                    {
                        <li>@fruit.Name @*  Quantity: @fruit.Quantity - Total Value: £@fruit.TotalValue.ToString("0.00") *@</li>
                    }
                    
            </ul>
            <h5>Total Daily Earnings: £@day.TotalPrice.ToString("0.00")</h5>

           <hr />
          
        }
    </tr>
</table>
</div>
