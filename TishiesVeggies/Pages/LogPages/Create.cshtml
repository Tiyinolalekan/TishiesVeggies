<script>
        function selectFruit(card, fruitId) {

        document.querySelectorAll('.fruit-card').forEach(c => {
            c.classList.remove('selected');
        });

        card.classList.add('selected');

        document.getElementById('selectedFruitId').value = fruitId;
    }
</script>
