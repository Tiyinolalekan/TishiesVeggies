@page
@model TishiesVeggies.Pages.FruitPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Fruit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Fruit.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Fruit.Name" class="control-label"></label>
                <input asp-for="Fruit.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Fruit.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Fruit.Category" class="control-label"></label>
                <input asp-for="Fruit.Category" class="form-control" aria-required="true"/>
                <span asp-validation-for="Fruit.Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Fruit.IsQuickAdd" class="control-label"></label>
                <input asp-for="Fruit.IsQuickAdd" class="form-check-input" />
                <span asp-validation-for="Fruit.IsQuickAdd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Fruit.Logs" class="control-label"></label>
                <input asp-for="Fruit.Logs" class="form-control" />
                <span asp-validation-for="Fruit.Logs" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
